Subject: [PATCH 4/4] vesuvius: ship the napari trainer's default config in the
 wheel

vesuvius.napari_trainer loads models/configuration/single_task/
ps128_dicece.yaml at startup, but the YAML was not package data, so an
installed wheel raised FileNotFoundError before the window opened.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 vesuvius/pyproject.toml                           |  1 +
 vesuvius/tests/napari_trainer/test_main_window.py | 10 ++++++++++
 2 files changed, 11 insertions(+)

diff --git a/vesuvius/pyproject.toml b/vesuvius/pyproject.toml
index e645bf3b8..3a7c67c63 100644
--- a/vesuvius/pyproject.toml
+++ b/vesuvius/pyproject.toml
@@ -187,6 +187,7 @@ where = ["src"]
 [tool.setuptools.package-data]
 vesuvius = [
     "install/configs/cubes.yaml",
+    "models/configuration/single_task/ps128_dicece.yaml",
     "ink_detection/configs/*.json",
     "tifxyz_label_transfer/*.cpp",
     "neural_tracing/fiber_trace_3d/fiber_lemon.cpp",
diff --git a/vesuvius/tests/napari_trainer/test_main_window.py b/vesuvius/tests/napari_trainer/test_main_window.py
index cf101ba53..c987f5c38 100644
--- a/vesuvius/tests/napari_trainer/test_main_window.py
+++ b/vesuvius/tests/napari_trainer/test_main_window.py
@@ -6,9 +6,11 @@ config manager, the layer export and the trainer's ZarrDataset are the real ones
 import importlib
 import inspect
 import sys
+import tomllib
 import tempfile
 import types
 from copy import deepcopy
+from fnmatch import fnmatch
 from pathlib import Path
 from types import SimpleNamespace
 
@@ -327,3 +329,11 @@ def test_offered_losses_fit_the_default_target_and_keep_its_ignore_label(main_wi
         changed[:, :, :4] = torch.randn_like(changed[:, :, :4]) * 10  # only where the label is ignored
         torch.testing.assert_close(loss_fn(changed, target), loss, msg=name)
 
+
+def test_default_config_is_package_data(main_window):
+    pyproject = Path(__file__).resolve().parents[2] / "pyproject.toml"
+    patterns = tomllib.loads(pyproject.read_text())["tool"]["setuptools"]["package-data"]["vesuvius"]
+    package_dir = Path(main_window.__file__).resolve().parents[1]
