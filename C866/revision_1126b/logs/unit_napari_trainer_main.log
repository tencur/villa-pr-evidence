                self.mgr = mgr
    
            def train(self):
                seen["dataset"] = ZarrDataset(mgr=self.mgr, is_training=True)
                seen["targets"] = {name: dict(info) for name, info in self.mgr.targets.items()}
                # the exported layers are removed when the run ends
