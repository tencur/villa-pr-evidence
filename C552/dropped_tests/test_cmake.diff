+add_executable(test_surface_rotation_apply
+    test_surface_rotation_apply.cpp
+    $<FILTER:$<TARGET_OBJECTS:VC3D>,EXCLUDE,VCAppMain>)
+
+set_target_properties(test_surface_rotation_apply PROPERTIES
+    AUTOMOC ON AUTOUIC OFF AUTORCC OFF)
+
+target_include_directories(test_surface_rotation_apply PRIVATE
+    ${PROJECT_SOURCE_DIR}/apps/VC3D
+    ${PROJECT_SOURCE_DIR}/core/src)
+
+target_link_libraries(test_surface_rotation_apply PRIVATE
+    $<TARGET_GENEX_EVAL:VC3D,$<TARGET_PROPERTY:VC3D,LINK_LIBRARIES>>
+    Qt6::Test)
+
+add_test(NAME surface_rotation_apply COMMAND test_surface_rotation_apply)
+set_tests_properties(surface_rotation_apply PROPERTIES
+    ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
+vc_register_test_target(test_surface_rotation_apply)
+vc_register_ctest(surface_rotation_apply test_surface_rotation_apply)
+
